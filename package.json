{
  "name": "@petergreenappliedai/flowmcp",
  "version": "0.9.3",
  "description": "Workflow-first MCP server: each tool is one deterministic workflow",
  "type": "module",
  "bin": {
    "flowmcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "flows",
    "FORMAT.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "json5": "^2.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterGreenAppliedAI/FlowMCP.git"
  },
  "homepage": "https://github.com/PeterGreenAppliedAI/FlowMCP#readme",
  "bugs": {
    "url": "https://github.com/PeterGreenAppliedAI/FlowMCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "workflow",
    "agent",
    "tools",
    "llm",
    "deterministic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
