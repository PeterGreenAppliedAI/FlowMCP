{
  "name": "flowmcp",
  "version": "0.2.0",
  "description": "Workflow-first MCP server: each tool is one deterministic workflow",
  "type": "module",
  "bin": {
    "flowmcp": "dist/server.js"
  },
  "files": [
    "dist",
    "flows",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
